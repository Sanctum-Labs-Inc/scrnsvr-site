---
import Doc from '../layouts/Doc.astro';
---
<Doc
  title="Reset your password · scrnsvr"
  description="Choose a new password for your ScrnSvr account."
>
  <h1>Reset your password</h1>

  <p id="checking" class="status">Checking your link…</p>

  <form id="reset-form" hidden novalidate>
    <label for="password">New password</label>
    <input id="password" type="password" autocomplete="new-password" minlength="6" required />
    <label for="confirm">Type it again</label>
    <input id="confirm" type="password" autocomplete="new-password" minlength="6" required />
    <p id="form-error" class="error" role="alert" hidden></p>
    <button id="save" type="submit">Save new password</button>
  </form>

  <div id="done" hidden>
    <p>Your password has been changed. Open ScrnSvr on your iPhone and sign in with your email and new password.</p>
  </div>

  <div id="invalid" hidden>
    <p id="invalid-reason">This link has expired or has already been used.</p>
    <p>In ScrnSvr, tap <strong>use email instead</strong>, enter your email, then <strong>forgot password?</strong> to get a new link.</p>
  </div>

  <p class="help">Need help? Email <a href="mailto:support@scrnsvr.art">support@scrnsvr.art</a>.</p>
</Doc>

<style>
  form { display: grid; gap: 10px; max-width: 360px; margin: 8px 0 24px; }
  label { font-size: 15px; color: #bdbdbd; }
  input {
    font: inherit;
    color: #fff;
    background: #141414;
    border: 1px solid #333;
    border-radius: 10px;
    padding: 12px 14px;
  }
  input:focus-visible { outline: 2px solid #fbda54; outline-offset: 1px; border-color: transparent; }
  button {
    margin-top: 8px;
    font: 600 16px/1 -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    color: #000;
    background: #fbda54;
    border: 0;
    border-radius: 24px;
    padding: 15px 20px;
    cursor: pointer;
  }
  button:disabled { opacity: 0.6; cursor: default; }
  button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .status { color: #8c8c8c; }
  .error { color: #ff9a9a; font-size: 15px; margin: 0; }
  .help { margin-top: 40px; color: #8c8c8c; font-size: 15px; }
</style>

<script>
  import { appSupabase } from '../lib/appSupabase';

  const show = (id: string) => document.getElementById(id)!.hidden = false;
  const hide = (id: string) => document.getElementById(id)!.hidden = true;

  // The reset email links here with the recovery session in the URL fragment
  // (#access_token=…&type=recovery), or with an error if it has expired.
  const fragment = new URLSearchParams(window.location.hash.slice(1));
  const linkError = fragment.get('error_description');

  async function start() {
    if (linkError) return invalid();
    // The client reads the fragment as it starts up.
    const { data: { session } } = await appSupabase.auth.getSession();
    if (!session) return invalid();
    // Keep the tokens out of the address bar and browser history.
    history.replaceState(null, '', window.location.pathname);
    hide('checking');
    show('reset-form');
    (document.getElementById('password') as HTMLInputElement).focus();
  }

  function invalid() {
    hide('checking');
    show('invalid');
  }

  document.getElementById('reset-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const confirm = (document.getElementById('confirm') as HTMLInputElement).value;
    const errorEl = document.getElementById('form-error')!;
    const save = document.getElementById('save') as HTMLButtonElement;
    const fail = (message: string) => {
      errorEl.textContent = message;
      errorEl.hidden = false;
    };
    errorEl.hidden = true;

    if (password.length < 6) return fail('Use at least 6 characters.');
    if (password !== confirm) return fail('The two passwords don’t match.');

    save.disabled = true;
    save.textContent = 'Saving…';
    const { error } = await appSupabase.auth.updateUser({ password });
    if (error) {
      save.disabled = false;
      save.textContent = 'Save new password';
      return fail(
        error.message.toLowerCase().includes('different')
          ? 'Choose a password you haven’t used for this account before.'
          : 'Couldn’t save your password. Try again, or request a new link from the app.',
      );
    }
    await appSupabase.auth.signOut({ scope: 'local' });
    hide('reset-form');
    show('done');
  });

  start().catch(invalid);
</script>
